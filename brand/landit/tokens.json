{
  "$description": "LANDIT design tokens. Rules: https://asset.landit.com.au/brand/landit/AGENTS.md",
  "color": {
    "red": { "$type": "color", "$value": "#D31E31" },
    "navy": { "$type": "color", "$value": "#1A1B26" },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "red-90": { "$type": "color", "$value": "#D73446" },
    "red-80": { "$type": "color", "$value": "#DB4B5A" },
    "red-70": { "$type": "color", "$value": "#E0616F" },
    "red-60": { "$type": "color", "$value": "#E47883" },
    "red-50": { "$type": "color", "$value": "#E88E97" },
    "navy-90": { "$type": "color", "$value": "#31323C" },
    "navy-80": { "$type": "color", "$value": "#474851" },
    "navy-70": { "$type": "color", "$value": "#5F5F67", "$description": "Lightest navy allowed for text on white" },
    "navy-60": { "$type": "color", "$value": "#75767C" },
    "navy-50": { "$type": "color", "$value": "#8C8C92", "$description": "Borders and disabled only, never text" },
    "surface-alt": { "$type": "color", "$value": "#F4F4F5" }
  },
  "role": {
    "text": { "$type": "color", "$value": "{color.navy}" },
    "text-muted": { "$type": "color", "$value": "{color.navy-70}" },
    "surface": { "$type": "color", "$value": "{color.white}" },
    "surface-impact": { "$type": "color", "$value": "{color.navy}" },
    "accent": { "$type": "color", "$value": "{color.red}" },
    "cta-bg": { "$type": "color", "$value": "{color.red}" },
    "cta-bg-hover": { "$type": "color", "$value": "{color.red-90}" },
    "cta-text": { "$type": "color", "$value": "{color.white}" }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["Poppins", "Helvetica Neue", "Arial", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Montserrat", "Helvetica Neue", "Arial", "sans-serif"] }
  },
  "size": {
    "logo-clearspace": { "$type": "dimension", "$value": "24px" },
    "logo-min-width": { "$type": "dimension", "$value": "120px" },
    "mark-min-size": { "$type": "dimension", "$value": "16px" },
    "icon": { "$type": "dimension", "$value": "24px" }
  }
}
